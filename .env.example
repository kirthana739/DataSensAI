# Copy this file to .env and fill in your real values.
# .env is gitignored and never committed - .env.example is the template
# that IS committed, so anyone cloning the repo knows what to set.

SECRET_KEY=change-this-to-any-random-string

DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your-mysql-password
DB_NAME=datasense_ai

# Optional. Leave blank to use the built-in rule-based insights fallback
# instead of Claude-generated ones.
ANTHROPIC_API_KEY=
